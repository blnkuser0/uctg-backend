# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ugnexa-catalyst?replicaSet=ugnexa-dev

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Resend (password reset emails) — get an API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ugnexa Catalyst <onboarding@resend.dev>

# Temporary password every admin-created account starts with (emailed to the new user).
# Change it here to rotate it; users are asked to replace it after their first sign-in.
NEW_USER_TEMP_PASSWORD=uctg123!
